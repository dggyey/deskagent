# LLM：任选一个 OpenAI 兼容服务
# 1) OpenAI 官方
#    OPENAI_API_KEY=sk-...
#    LLM_MODEL=gpt-4o-mini
# 2) DeepSeek（国内直连）
#    OPENAI_API_KEY=sk-...
#    OPENAI_BASE_URL=https://api.deepseek.com
#    LLM_MODEL=deepseek-chat
# 3) 通义千问 DashScope（国内直连）
#    OPENAI_API_KEY=sk-...
#    OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    LLM_MODEL=qwen-plus
# 4) OpenRouter（可接 Claude 等系列）
#    OPENAI_API_KEY=sk-or-...
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL=anthropic/claude-sonnet-4.5
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# OneBot / LLOneBot backend
# 在公司用 mock 后端：http://127.0.0.1:11451
# 回家接真实 LLOneBot：http://127.0.0.1:3000
ONEBOT_HTTP_URL=http://127.0.0.1:11451
ONEBOT_WS_URL=ws://127.0.0.1:11451/ws
ONEBOT_ACCESS_TOKEN=

# MCP Server
QQ_MCP_SERVER_NAME=qq-mcp
MCP_TRANSPORT=stdio  # stdio 或 sse

# Agent
AGENT_OWNER_QQ=
AUTO_REPLY_COOLDOWN_SECONDS=3
LOG_LEVEL=INFO
